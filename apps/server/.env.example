# OAuth gateway（new-api）配置，复制为 .env 后填写真实值
GATEWAY_BASE_URL=https://newapi.0xfiang.com
GATEWAY_CLIENT_ID=
APP_PUBLIC_URL=http://localhost:5173
# 本地 server 端口，默认 3000；3000 被占用时可换（前端 Vite 代理需同步）
TOONFLOW_SERVER_PORT=3100
# 可选：网关对外访问地址，默认同 GATEWAY_BASE_URL
# GATEWAY_PUBLIC_URL=
# 可选：授权 scope，默认 "openid profile email api:read api:write"
# GATEWAY_CLIENT_SCOPES=openid profile email api:read api:write
